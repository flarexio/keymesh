{
  "name": "keymesh-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "build:wasm": "../../scripts/build-wasm.sh",
    "build": "ng build",
    "start": "node scripts/serve.mjs 4310",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "test": "ng test --watch=false",
    "e2e": "playwright test",
    "tls-check": "node scripts/tls-check.mjs",
    "test:serve": "node --test scripts/serve.test.mjs scripts/favicon.test.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "22.2.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zxing-wasm": "3.1.7"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "fake-indexeddb": "6.2.6",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "simple-icons": "16.37.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
