{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/favicon.ico",
          "/manifest.webmanifest",
          "/preferences-boot.js",
          "/*.css",
          "/*.js",
          "/wasm/*.wasm",
          "/icons/*.png"
        ]
      }
    }
  ],
  "navigationUrls": ["/", "/index.html"],
  "navigationRequestStrategy": "performance"
}
